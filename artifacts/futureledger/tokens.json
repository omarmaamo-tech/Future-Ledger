{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f5f5" },
      "foreground": { "$value": "#080808" },
      "border": { "$value": "#dedede" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#080808" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#080808" },
      "primary": {
        "$value": "#080808",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#ededed" },
      "secondaryForeground": { "$value": "#080808" },
      "muted": { "$value": "#eeeeee" },
      "mutedForeground": { "$value": "#545454" },
      "accent": { "$value": "#1f467d" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#bd2929" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#dedede" },
      "ring": { "$value": "#080808" },
      "chart1": { "$value": "#080808" },
      "chart2": { "$value": "#2f6196" },
      "chart3": { "$value": "#d78a2d" },
      "chart4": { "$value": "#717171" },
      "chart5": { "$value": "#4d82a8" },
      "sidebar": { "$value": "#080808" },
      "sidebarForeground": { "$value": "#f5f5f5" },
      "sidebarBorder": { "$value": "#303030" },
      "sidebarPrimary": { "$value": "#1f467d" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#202020" },
      "sidebarAccentForeground": { "$value": "#f5f5f5" },
      "sidebarRing": { "$value": "#1f467d" }
    },
    "dark": {
      "background": { "$value": "#090909" },
      "foreground": { "$value": "#f5f5f5" },
      "border": { "$value": "#303030" },
      "card": { "$value": "#141414" },
      "cardForeground": { "$value": "#f5f5f5" },
      "popover": { "$value": "#141414" },
      "popoverForeground": { "$value": "#f5f5f5" },
      "primary": { "$value": "#f5f5f5" },
      "primaryForeground": { "$value": "#080808" },
      "secondary": { "$value": "#222222" },
      "secondaryForeground": { "$value": "#f5f5f5" },
      "muted": { "$value": "#1b1b1b" },
      "mutedForeground": { "$value": "#b8b8b8" },
      "accent": { "$value": "#6f95d6" },
      "accentForeground": { "$value": "#0b1224" },
      "destructive": { "$value": "#ff7777" },
      "destructiveForeground": { "$value": "#260b0b" },
      "input": { "$value": "#414141" },
      "ring": { "$value": "#d2ff3a" },
      "chart1": { "$value": "#f5f5f5" },
      "chart2": { "$value": "#72a2d7" },
      "chart3": { "$value": "#f0a65a" },
      "chart4": { "$value": "#929292" },
      "chart5": { "$value": "#70a6c9" },
      "sidebar": { "$value": "#050505" },
      "sidebarForeground": { "$value": "#f5f5f5" },
      "sidebarBorder": { "$value": "#2b2b2b" },
      "sidebarPrimary": { "$value": "#6f95d6" },
      "sidebarPrimaryForeground": { "$value": "#0b1224" },
      "sidebarAccent": { "$value": "#1b1b1b" },
      "sidebarAccentForeground": { "$value": "#f5f5f5" },
      "sidebarRing": { "$value": "#6f95d6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["IBM Plex Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
